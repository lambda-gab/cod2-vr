#include "setup_res.h"
IDI_SETUP         ICON   "setup.ico"
// Mod files embedded in the setup; ..\proxy\build.bat and ..\launcher\build_launcher.bat produce them
IDR_D3D9          RCDATA "..\\proxy\\out\\d3d9.dll"
IDR_OPENXR_LOADER RCDATA "..\\proxy\\out\\openxr_loader.dll"
IDR_COD2_VR_INI   RCDATA "..\\proxy\\cod2_vr.ini"
IDR_LAUNCHER      RCDATA "..\\launcher\\out\\Call of Duty 2 VR.exe"
IDR_SUPPORTERS    RCDATA "..\\launcher\\supporters.ini"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Call of Duty 2 VR setup"
      VALUE "ProductName", "Call of Duty 2 VR"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
